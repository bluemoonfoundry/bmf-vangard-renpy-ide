  {
    "id": "recovery-snapshot-limits",
    "claim": "Recovery snapshots: 25 MB each, 3 per project, 200 MB total, 30 days",
    "doc": "website/reference/troubleshooting-faq.md",
    "pattern": "maxSnapshotBytes: 25 \\* 1024 \\* 1024,\\s*maxFilesPerProject: 3,\\s*maxTotalBytes: 200 \\* 1024 \\* 1024,\\s*maxAgeMs: 30 \\*",
    "files": ["src/lib/recoveryStore.js"]
  },
  {
    "id": "recovery-snapshot-dir",
    "claim": "Recovery snapshots are stored under userData/recovery",
    "doc": "website/reference/file-formats.md",
