  {
    "id": "corrupt-settings-backup-name",
    "claim": "Unreadable project.ide.json is backed up as project.ide.json.corrupt-<timestamp>.bak",
    "doc": "website/reference/file-formats.md",
    "pattern": "'\\.corrupt-' \\+ stamp \\+ '\\.bak'",
    "files": ["electron.js"]
