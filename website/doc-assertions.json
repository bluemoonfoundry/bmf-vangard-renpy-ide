    "files": ["electron.js"]
  },
  {
    "id": "recovery-snapshot-timing",
    "claim": "Snapshots are written 5 s after edits, at least every 60 s",
    "doc": "website/architecture/STATE_PERSISTENCE.md",
    "pattern": "debounceMs \\?\\? 5000;[\\s\\S]*maxIntervalMs \\?\\? 60000",
    "files": ["src/hooks/useRecoverySnapshots.ts"]
  }
